# Copy to .env (never commit .env). SANDBOX credentials only: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Optional
PAYPAL_SANDBOX_WEBHOOK_ID=
PORT=3000
PROOFPILOT_DRY_RUN=0
PROOFPILOT_ACCEPT_BELOW=0
PROOFPILOT_ENABLE_SANDBOX_TOOLS=0
